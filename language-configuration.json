{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [],
  "autoClosingPairs": [{ "open": "\"", "close": "\"" }],
  "surroundingPairs": [{ "open": "\"", "close": "\"" }],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(Show|Hide|Minimal)\\b",
    "decreaseIndentPattern": "^\\s*(Show|Hide|Minimal)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s+$",
      "action": { "indent": "outdent" }
    }
  ],
  "folding": {
    "markers": {
      "start": "^(Show|Hide|Minimal)\\b.*$",
      "end": "^(?=Show|Hide|Minimal|$)"
    }
  }
}
